# Copy to .env.local for an existing Supabase project, or run pnpm local:setup.
APP_ORIGIN=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never use NEXT_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=
# Restricted app_runtime role; use Supabase transaction pooler (6543) on Vercel.
DATABASE_URL=postgresql://app_runtime.pooler-dev:CHANGE_ME@127.0.0.1:54329/postgres
# Migration/administration only; direct DB or session pooler (5432), never transaction pooler.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
