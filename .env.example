# Copy to .env.local for an existing Supabase project, or run pnpm local:setup.
# Optional local E2E runner base URL; not required by the app or Vercel.
# APP_ORIGIN=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never use NEXT_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=
# Restricted app_runtime role; use Supabase transaction pooler (6543) on Vercel.
DATABASE_URL=postgresql://app_runtime.pooler-dev:CHANGE_ME@127.0.0.1:54329/postgres
# Migration/administration only; direct DB or session pooler (5432), never transaction pooler.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# M6 web push. Leave PUSH_ENABLED=false outside production/staging.
APP_ENV=local
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
JOB_TRIGGER_SECRET=

# Comma-separated Auth user UUIDs; staging sends only to this explicit allowlist.
PUSH_STAGING_USER_IDS=

# Optional server-only shortcuts, available only in local next dev.
# Use dedicated test accounts with matching app.AppUser roles; never NEXT_PUBLIC_.
DEV_LOGIN_USER_EMAIL=
DEV_LOGIN_USER_PASSWORD=
DEV_LOGIN_ADMIN_EMAIL=
DEV_LOGIN_ADMIN_PASSWORD=
